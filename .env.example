# iCloud username (required) — your Apple ID email.
ICLOUD_USERNAME=you@icloud.com

# App-specific password (OPTIONAL fallback only).
# Preferred: store it in your OS keyring instead of here (see README).
# If set, this env var is used only when no keyring entry is found.
# ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Keyring service name to read the password from (default: icloud-mcp).
# Set this to reuse an existing keyring entry, e.g. "my-icloud".
# ICLOUD_KEYRING_SERVICE=icloud-mcp

# Enable mutating tools (send_mail, create_event). OFF by default.
# When unset, write tools refuse with an error. Even when enabled, every write
# still requires an interactive confirmation. Accepts 1/true/yes/on.
# ICLOUD_ENABLE_WRITES=1

# Server / endpoint overrides (optional — iCloud defaults shown).
# ICLOUD_IMAP_HOST=imap.mail.me.com
# ICLOUD_IMAP_PORT=993
# ICLOUD_SMTP_HOST=smtp.mail.me.com
# ICLOUD_SMTP_PORT=587
# ICLOUD_CALDAV_URL=https://caldav.icloud.com/
# ICLOUD_CARDDAV_URL=https://contacts.icloud.com/

# Timezone for rendering/scoping events (default: system local time).
# ICLOUD_TZ=America/New_York
